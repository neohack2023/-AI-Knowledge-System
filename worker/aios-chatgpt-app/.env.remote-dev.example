# AIOS_CHATGPT_APP_BRIDGE_DEPLOY_BINDING_02
# Developer Mode deployment profile. Copy values into the deployment secret/env
# manager. Do not commit real secrets or private endpoints.

AIOS_MCP_DEPLOYMENT_PROFILE=remote-dev

# Stable HTTPS origin for the deployed AI Knowledge System Sites application.
AIOS_BACKEND_ORIGIN=https://REPLACE_WITH_DEPLOYED_AIOS_ORIGIN

# Must match AIOS_BRIDGE_TOKEN configured on the AI Knowledge System backend.
AIOS_BRIDGE_TOKEN=REPLACE_IN_SECRET_MANAGER

# Network bind inside the MCP container/host.
HOST=0.0.0.0
PORT=8000

# Exact Host header values admitted by the MCP transport-security middleware.
# Include the deployment hostname and port only if the platform preserves it.
MCP_ALLOWED_HOSTS=mcp.example.com

# Optional exact Origin header allowlist. Leave empty only when the chosen
# ChatGPT/server connection sends no Origin header. Add observed legitimate
# origins explicitly; do not use '*'.
MCP_ALLOWED_ORIGINS=
