{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aios:schemas:verifier-acceptance:v0.1",
  "title": "AIOS Verifier Acceptance v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "acceptance_id",
    "scope_key",
    "task_id",
    "artifact_or_object_id",
    "artifact_version_or_head",
    "artifact_digest",
    "obligation_id",
    "obligation_description",
    "verifier_id",
    "verifier_version",
    "verifier_authority_class",
    "verifier_input_digest",
    "verifier_freshness_state",
    "coverage_state",
    "result",
    "terminal_acceptance_effect",
    "higher_priority_verifier_ids",
    "lower_priority_evidence_ids",
    "retry_allowed",
    "repair_feedback_pointer",
    "receipt_pointer"
  ],
  "properties": {
    "schema": { "const": "aios_verifier_acceptance_v0_1" },
    "acceptance_id": { "type": "string", "minLength": 1 },
    "scope_key": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "artifact_or_object_id": { "type": "string", "minLength": 1 },
    "artifact_version_or_head": { "type": "string", "minLength": 1 },
    "artifact_digest": { "type": "string", "minLength": 1 },
    "obligation_id": { "type": "string", "minLength": 1 },
    "obligation_description": { "type": "string", "minLength": 1 },
    "verifier_id": { "type": "string", "minLength": 1, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$" },
    "verifier_version": { "type": "string", "minLength": 1 },
    "verifier_authority_class": {
      "enum": ["HARD_KERNEL", "DETERMINISTIC_TASK_NATIVE", "EXACT_COMPARATOR", "EXECUTABLE_SCOPED", "HUMAN_GOVERNED", "MODEL_ADVISORY"]
    },
    "verifier_input_digest": { "type": "string", "minLength": 1 },
    "verifier_freshness_state": { "enum": ["CURRENT", "STALE", "UNKNOWN"] },
    "coverage_state": { "enum": ["COMPLETE_FOR_OBLIGATION", "PARTIAL", "UNKNOWN"] },
    "result": { "enum": ["PASS", "FAIL", "PARTIAL", "BLOCKED", "UNKNOWN"] },
    "terminal_acceptance_effect": { "enum": ["ACCEPT", "REJECT", "NO_TERMINAL_EFFECT", "ESCALATE"] },
    "higher_priority_verifier_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$" } },
    "lower_priority_evidence_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$" } },
    "retry_allowed": { "type": "boolean" },
    "repair_feedback_pointer": { "type": ["string", "null"], "minLength": 1 },
    "receipt_pointer": { "type": ["string", "null"], "minLength": 1 }
  }
}
