{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://schemas/PublicReleaseManifest/1.0",
  "title": "PublicReleaseManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "release_id",
    "default_classification",
    "allowlist",
    "denylist",
    "content_rules",
    "exceptions",
    "private_terms"
  ],
  "properties": {
    "schema_name": { "const": "PublicReleaseManifest" },
    "schema_version": { "const": "1.0" },
    "release_id": { "type": "string", "minLength": 1 },
    "default_classification": { "const": "UNRESOLVED" },
    "allowlist": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pathRule" }
    },
    "denylist": {
      "type": "array",
      "items": { "$ref": "#/$defs/pathRule" }
    },
    "content_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contentRule" }
    },
    "exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exceptionRule" }
    },
    "private_terms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_variable", "local_file"],
      "properties": {
        "environment_variable": { "type": "string", "minLength": 1 },
        "local_file": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "classification": {
      "enum": [
        "PUBLIC_CORE",
        "PUBLIC_TEMPLATE",
        "PUBLIC_SYNTHETIC_FIXTURE",
        "PRIVATE_KNOWLEDGE",
        "PRIVATE_BINDING",
        "PRIVATE_EVIDENCE",
        "SECRET",
        "UNRESOLVED"
      ]
    },
    "pathRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pattern", "classification", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "pattern": { "type": "string", "minLength": 1 },
        "classification": { "$ref": "#/$defs/classification" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "contentRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "classification", "pattern", "flags", "replacement"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "classification": { "$ref": "#/$defs/classification" },
        "pattern": { "type": "string", "minLength": 1 },
        "flags": { "type": "string", "pattern": "^[dgimsuvy]*$" },
        "replacement": { "type": "string", "minLength": 1 }
      }
    },
    "exceptionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content_rule_id", "path_pattern", "pattern", "flags", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "content_rule_id": { "type": "string", "minLength": 1 },
        "path_pattern": { "type": "string", "minLength": 1 },
        "pattern": { "type": "string", "minLength": 1 },
        "flags": { "type": "string", "pattern": "^[dgimsuvy]*$" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
