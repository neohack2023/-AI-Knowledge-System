{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aios:schemas:coding-harness-receipt:v0.1",
  "title": "AIOS Coding Harness Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verifier_acceptance_schema",
    "repository",
    "head_sha",
    "base_sha",
    "profile",
    "environment",
    "changed_paths",
    "checks",
    "artifacts",
    "known_regressions_loaded",
    "failed_reason_codes",
    "obligations",
    "verifier_acceptances",
    "terminal_status",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": { "const": "aios-coding-harness/v0.1" },
    "verifier_acceptance_schema": { "const": "aios_verifier_acceptance_v0_1" },
    "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "head_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "base_sha": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$" },
    "profile": { "enum": ["FAST", "PR", "FULL", "NIGHTLY"] },
    "environment": { "type": "object" },
    "changed_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "checks": { "type": "array", "items": { "type": "object" } },
    "artifacts": { "type": "array", "items": { "type": "object" } },
    "known_regressions_loaded": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "failed_reason_codes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": ["required"],
        "properties": {
          "required": { "const": true }
        }
      },
      "minContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["obligation_id", "description", "required", "state", "acceptance_ids", "advisory_acceptance_ids", "reason_codes"],
        "properties": {
          "obligation_id": { "type": "string", "minLength": 1, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$" },
          "description": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "required": { "type": "boolean" },
          "state": { "enum": ["ACCEPTED", "REJECTED", "PARTIAL", "BLOCKED", "OPEN"] },
          "acceptance_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "advisory_acceptance_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "reason_codes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "verifier_acceptances": {
      "type": "array",
      "items": { "$ref": "urn:aios:schemas:verifier-acceptance:v0.1" }
    },
    "terminal_status": { "enum": ["PASS", "FAIL", "PARTIAL", "FLAKY", "BLOCKED"] },
    "receipt_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
