{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://schemas/AiosRegistryContracts/1.0",
  "title": "AIOS Registry Contracts 1.0",
  "$defs": {
    "health": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "checked_at", "expires_at"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "checked_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "repoRegistrySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "schema_version", "registry_version", "routing_precedence"],
      "properties": {
        "schema_name": { "const": "RepoRegistrySource" },
        "schema_version": { "const": "1.0" },
        "registry_version": { "type": "string", "minLength": 1 },
        "routing_precedence": {
          "type": "array",
          "minItems": 6,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "scopeDefinition": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_name", "schema_version", "scope_key", "project_name", "parent_scope_key", "status", "health"],
      "properties": {
        "schema_name": { "const": "ScopeDefinition" },
        "schema_version": { "const": "1.0" },
        "scope_key": { "type": "string", "minLength": 1 },
        "project_name": { "type": "string", "minLength": 1 },
        "parent_scope_key": { "type": ["string", "null"] },
        "status": { "enum": ["ACTIVE", "REVIEW", "DEPRECATED", "SUPERSEDED"] },
        "health": { "$ref": "#/$defs/health" }
      }
    },
    "aliasDefinition": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_name", "schema_version", "alias_id", "alias", "scope_key", "status"],
      "properties": {
        "schema_name": { "const": "AliasDefinition" },
        "schema_version": { "const": "1.0" },
        "alias_id": { "type": "string", "minLength": 1 },
        "alias": { "type": "string", "minLength": 1 },
        "scope_key": { "type": "string", "minLength": 1 },
        "status": { "enum": ["ACTIVE", "DEPRECATED", "SUPERSEDED"] }
      }
    },
    "workflowRegistryEntry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_name", "schema_version", "workflow_id", "version", "status", "handler_ref", "handler_available", "execution_modes"],
      "properties": {
        "schema_name": { "const": "WorkflowRegistryEntry" },
        "schema_version": { "const": "1.0" },
        "workflow_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "status": { "enum": ["ACTIVE", "REVIEW", "DEPRECATED", "SUPERSEDED"] },
        "handler_ref": { "type": "string", "minLength": 1 },
        "handler_available": { "type": "boolean" },
        "execution_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["LIVE", "SIMULATION"] },
          "uniqueItems": true
        }
      }
    },
    "authorityBinding": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_name", "schema_version", "binding_id", "scope_key", "authority_domain", "authority_role", "read_from", "write_authorized", "status"],
      "properties": {
        "schema_name": { "const": "AuthorityBinding" },
        "schema_version": { "const": "1.0" },
        "binding_id": { "type": "string", "minLength": 1 },
        "scope_key": { "type": "string", "minLength": 1 },
        "authority_domain": { "type": "string", "minLength": 1 },
        "authority_role": { "type": "string", "minLength": 1 },
        "read_from": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "write_authorized": { "type": "boolean" },
        "status": { "enum": ["ACTIVE", "REVIEW", "DEPRECATED", "SUPERSEDED"] }
      }
    },
    "runtimeCapabilityDefinition": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_name",
        "schema_version",
        "capability_id",
        "name",
        "workflow_id",
        "version",
        "status",
        "discoverable",
        "input_schema",
        "output_schema",
        "expected_schema_fingerprint",
        "handler_ref",
        "health"
      ],
      "properties": {
        "schema_name": { "const": "RuntimeCapabilityDefinition" },
        "schema_version": { "const": "1.0" },
        "capability_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "workflow_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "status": { "enum": ["ACTIVE", "REVIEW", "DEPRECATED", "SUPERSEDED"] },
        "discoverable": { "type": "boolean" },
        "input_schema": { "type": "object" },
        "output_schema": { "type": "object" },
        "expected_schema_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "handler_ref": { "type": "string", "minLength": 1 },
        "health": { "$ref": "#/$defs/health" }
      }
    },
    "routingTables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact_scope_keys", "exact_project_names", "exact_aliases", "children_by_parent"],
      "properties": {
        "exact_scope_keys": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "exact_project_names": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "exact_aliases": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "children_by_parent": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "compiledAiosRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_name",
        "schema_version",
        "registry_version",
        "routing_precedence",
        "routing_tables",
        "scopes",
        "aliases",
        "capabilities",
        "workflows",
        "authority",
        "registry_fingerprint",
        "inventory_projection_fingerprint"
      ],
      "properties": {
        "schema_name": { "const": "CompiledAiosRegistry" },
        "schema_version": { "const": "1.0" },
        "registry_version": { "type": "string", "minLength": 1 },
        "routing_precedence": { "type": "array", "items": { "type": "string" } },
        "routing_tables": { "$ref": "#/$defs/routingTables" },
        "scopes": { "type": "array", "items": { "$ref": "#/$defs/scopeDefinition" } },
        "aliases": { "type": "array", "items": { "$ref": "#/$defs/aliasDefinition" } },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/runtimeCapabilityDefinition" } },
        "workflows": { "type": "array", "items": { "$ref": "#/$defs/workflowRegistryEntry" } },
        "authority": { "type": "array", "items": { "$ref": "#/$defs/authorityBinding" } },
        "registry_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "inventory_projection_fingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/repoRegistrySource" },
    { "$ref": "#/$defs/scopeDefinition" },
    { "$ref": "#/$defs/aliasDefinition" },
    { "$ref": "#/$defs/workflowRegistryEntry" },
    { "$ref": "#/$defs/authorityBinding" },
    { "$ref": "#/$defs/runtimeCapabilityDefinition" },
    { "$ref": "#/$defs/compiledAiosRegistry" }
  ]
}
