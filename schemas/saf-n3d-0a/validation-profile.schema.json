{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.local/schemas/saf-n3d-0a/validation-profile-v0.1.json",
  "title": "SAF-N3D-0A Validation Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "profile_id",
    "version",
    "applies_to",
    "geometry_rules",
    "material_rules",
    "rig_rules",
    "human_review",
    "rights_rules"
  ],
  "properties": {
    "contract": {"const": "SpatialValidationProfile/0.1"},
    "profile_id": {"type": "string","minLength": 1,"maxLength": 128,"pattern": "^[A-Za-z0-9._:-]+$"},
    "version": {"type": "string","minLength": 1},
    "applies_to": {"type": "object","additionalProperties": false,"required": ["roles","representations"],"properties": {"roles": {"type": "array","minItems": 1,"uniqueItems": true,"items": {"enum": ["CHARACTER_BODY","COSTUME","WEAPON","ACCESSORY","PROP","ENVIRONMENT","MATERIAL_SET","RIG","OTHER"]}},"representations": {"type": "array","minItems": 1,"uniqueItems": true,"items": {"enum": ["MESH_ASSET_DRAFT","GAUSSIAN_SPLAT_CAPTURE","PROCEDURAL_MESH_SOURCE","RIGGED_CHARACTER_DRAFT"]}}}},
    "geometry_rules": {"type": "object","additionalProperties": false,"required": ["units","coordinate_system","max_vertices","max_faces","max_components","watertight_requirement","require_reimport"],"properties": {"units": {"const": "m"},"coordinate_system": {"const": "RIGHT_HANDED_Y_UP_NEGATIVE_Z_FORWARD"},"max_vertices": {"type": "integer","minimum": 1},"max_faces": {"type": "integer","minimum": 1},"max_components": {"type": "integer","minimum": 1},"watertight_requirement": {"enum": ["REQUIRED","NOT_REQUIRED","COMPONENT_SPECIFIC"]},"require_reimport": {"type": "boolean"}}},
    "material_rules": {"type": "object","additionalProperties": false,"required": ["uv_requirement","allowed_channels"],"properties": {"uv_requirement": {"enum": ["REQUIRED","NOT_REQUIRED","COMPONENT_SPECIFIC"]},"allowed_channels": {"type": "array","uniqueItems": true,"items": {"enum": ["BASE_COLOR","NORMAL","ROUGHNESS","METALLIC","OCCLUSION","EMISSIVE","OPACITY"]}}}},
    "rig_rules": {"type": "object","additionalProperties": false,"required": ["requirement","max_influences"],"properties": {"requirement": {"enum": ["REQUIRED","NOT_REQUIRED","LATER_STAGE"]},"max_influences": {"type": "integer","minimum": 0,"maximum": 16}}},
    "human_review": {"type": "object","additionalProperties": false,"required": ["required","reason_codes"],"properties": {"required": {"type": "boolean"},"reason_codes": {"type": "array","items": {"type": "string"}}}},
    "rights_rules": {"type": "object","additionalProperties": false,"required": ["accepted_states"],"properties": {"accepted_states": {"type": "array","minItems": 1,"uniqueItems": true,"items": {"enum": ["SYNTHETIC_FIXTURE","PRIVATE_RESEARCH","LICENSED","PUBLIC_DOMAIN"]}}}}
  }
}
