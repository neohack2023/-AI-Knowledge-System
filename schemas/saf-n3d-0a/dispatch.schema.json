{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.local/schemas/saf-n3d-0a/dispatch-v0.1.json",
  "title": "SAF-N3D-0A Dispatch",
  "description": "Bounded non-authoritative spatial compute dispatch. This contract grants no durable-write, provider, callback, or registry authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "workflow_version",
    "mode",
    "execution_profile",
    "validation_profile_id",
    "scope_key",
    "execution_id",
    "trace_id",
    "span_id",
    "parent_execution_id",
    "workflow_id",
    "repository",
    "candidate_package",
    "sources",
    "authorization"
  ],
  "properties": {
    "contract_version": {"const": "SAF-N3D-Dispatch/0.1"},
    "workflow_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "mode": {"enum": ["SIMULATION", "LIVE"]},
    "execution_profile": {"enum": ["MOCK_FIXTURE", "NEURAL_PROVIDER"]},
    "validation_profile_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "scope_key": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._:-]*[a-z0-9])?$"},
    "execution_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
    "trace_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "span_id": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
    "parent_execution_id": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"}, {"type": "null"}]},
    "workflow_id": {"const": "spatial-asset-foundry"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_name", "base_sha", "working_branch"],
      "properties": {
        "full_name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "base_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "working_branch": {"type": "string", "pattern": "^agent/saf-n3d-0a-[a-z0-9._-]+$"}
      }
    },
    "candidate_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "global_role", "representation_family", "generation_method", "blueprint_digest", "subtype_extensions"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
        "global_role": {"enum": ["CHARACTER_BODY", "COSTUME", "WEAPON", "ACCESSORY", "PROP", "ENVIRONMENT", "MATERIAL_SET", "RIG", "OTHER"]},
        "representation_family": {"enum": ["MESH_ASSET_DRAFT", "GAUSSIAN_SPLAT_CAPTURE", "PROCEDURAL_MESH_SOURCE", "RIGGED_CHARACTER_DRAFT"]},
        "generation_method": {"enum": ["IMAGE_TO_MESH", "IMAGE_TO_SPLAT", "PROCEDURAL", "MANUAL", "HYBRID", "MOCK_FIXTURE"]},
        "blueprint_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "subtype_extensions": {"type": "object", "additionalProperties": true}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_type", "logical_uri", "temporary_fetch_url", "fetch_url_expires_at", "digest", "provenance_envelope_id"],
        "properties": {
          "source_type": {"enum": ["REPOSITORY_FIXTURE", "TRANSIENT_INPUT", "GOOGLE_DRIVE"]},
          "logical_uri": {"type": "string", "minLength": 1, "maxLength": 2048},
          "temporary_fetch_url": {"oneOf": [{"type": "string", "format": "uri"}, {"type": "null"}]},
          "fetch_url_expires_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
          "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "provenance_envelope_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"}
        },
        "allOf": [
          {"if": {"properties": {"source_type": {"const": "GOOGLE_DRIVE"}}}, "then": {"properties": {"temporary_fetch_url": {"type": "string", "format": "uri"}, "fetch_url_expires_at": {"type": "string", "format": "date-time"}}}},
          {"if": {"properties": {"source_type": {"enum": ["REPOSITORY_FIXTURE", "TRANSIENT_INPUT"]}}}, "then": {"properties": {"temporary_fetch_url": {"type": "null"}, "fetch_url_expires_at": {"type": "null"}}}}
        ]
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorization_ref", "issued_at", "expires_at", "issued_for_execution_id", "scope_key", "repository_full_name", "base_sha", "allowed_effects", "forbidden_effects", "authorization_digest"],
      "properties": {
        "authorization_ref": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "issued_for_execution_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$"},
        "scope_key": {"type": "string"},
        "repository_full_name": {"type": "string"},
        "base_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "allowed_effects": {"type": "array", "uniqueItems": true, "items": {"enum": ["READ_SOURCE", "EXECUTE_BUILD", "CREATE_ACTIONS_ARTIFACT", "EMIT_RECEIPT"]}},
        "forbidden_effects": {"type": "array", "uniqueItems": true, "items": {"enum": ["MUTATE_NOTION", "WRITE_GOOGLE_DRIVE", "REGISTER_ASSET", "PROMOTE_CANON", "MERGE_DEFAULT_BRANCH", "INVOKE_NEURAL_PROVIDER", "SEND_CALLBACK"]}},
        "authorization_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      },
      "allOf": [
        {"properties": {"forbidden_effects": {"contains": {"const": "MUTATE_NOTION"}}}},
        {"properties": {"forbidden_effects": {"contains": {"const": "WRITE_GOOGLE_DRIVE"}}}},
        {"properties": {"forbidden_effects": {"contains": {"const": "REGISTER_ASSET"}}}},
        {"properties": {"forbidden_effects": {"contains": {"const": "PROMOTE_CANON"}}}},
        {"properties": {"forbidden_effects": {"contains": {"const": "MERGE_DEFAULT_BRANCH"}}}},
        {"properties": {"forbidden_effects": {"contains": {"const": "INVOKE_NEURAL_PROVIDER"}}}},
        {"properties": {"forbidden_effects": {"contains": {"const": "SEND_CALLBACK"}}}}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"execution_profile": {"const": "MOCK_FIXTURE"}}}, "then": {"properties": {"mode": {"const": "SIMULATION"}}}}
  ]
}
