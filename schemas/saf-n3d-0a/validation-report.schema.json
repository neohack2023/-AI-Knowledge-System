{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.local/schemas/saf-n3d-0a/validation-report-v0.1.json",
  "title": "SAF-N3D-0A Spatial Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract","scope_key","execution_id","candidate_id","representation_family","validation_profile_id","components","export_reimport","materials","rig","rights","technical_outcome","human_review","acceptance"],
  "properties": {
    "contract": {"const":"SpatialValidationReport/0.1"},
    "scope_key": {"type":"string"},
    "execution_id": {"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9._:-]+$"},
    "candidate_id": {"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9._:-]+$"},
    "representation_family": {"enum":["MESH_ASSET_DRAFT","GAUSSIAN_SPLAT_CAPTURE","PROCEDURAL_MESH_SOURCE","RIGGED_CHARACTER_DRAFT"]},
    "validation_profile_id": {"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9._:-]+$"},
    "components": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["component_id","role","topology_family","units","coordinate_system","bounds","dimensions","vertex_count","face_count","connected_components","degenerate_faces","zero_area_faces","non_manifold_edges","flipped_normals","self_intersections","watertight_requirement","watertight_observed","watertight_result"],"properties":{"component_id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9._:-]+$"},"role":{"enum":["CHARACTER_BODY","COSTUME","WEAPON","ACCESSORY","PROP","ENVIRONMENT","MATERIAL_SET","RIG","OTHER"]},"topology_family":{"enum":["POLYGONAL_MESH","GAUSSIAN_POINTS","VOLUMETRIC_FIELD","SKELETON","MATERIAL_ONLY"]},"units":{"const":"m"},"coordinate_system":{"const":"RIGHT_HANDED_Y_UP_NEGATIVE_Z_FORWARD"},"bounds":{"type":"object","additionalProperties":false,"required":["min","max"],"properties":{"min":{"$ref":"#/$defs/vector3"},"max":{"$ref":"#/$defs/vector3"}}},"dimensions":{"$ref":"#/$defs/vector3"},"vertex_count":{"type":"integer","minimum":0},"face_count":{"type":"integer","minimum":0},"connected_components":{"type":"integer","minimum":0},"degenerate_faces":{"type":"integer","minimum":0},"zero_area_faces":{"type":"integer","minimum":0},"non_manifold_edges":{"type":"integer","minimum":0},"flipped_normals":{"type":"integer","minimum":0},"self_intersections":{"oneOf":[{"type":"integer","minimum":0},{"type":"null"}]},"watertight_requirement":{"enum":["REQUIRED","NOT_REQUIRED","COMPONENT_SPECIFIC"]},"watertight_observed":{"type":"boolean"},"watertight_result":{"enum":["PASS","FAIL","NOT_APPLICABLE","REVIEW_REQUIRED"]}}}},
    "export_reimport": {"type":"object","additionalProperties":false,"required":["export_result","reimport_result","format","validator","structural_digest_match"],"properties":{"export_result":{"enum":["PASS","FAIL","NOT_RUN"]},"reimport_result":{"enum":["PASS","FAIL","NOT_RUN"]},"format":{"enum":["GLB","GLTF","PLY","SPLAT","OTHER"]},"validator":{"type":"string"},"structural_digest_match":{"oneOf":[{"type":"boolean"},{"type":"null"}]}}},
    "materials": {"type":"object","additionalProperties":false,"required":["uv_present","uv_overlap_result","channels_present","translation_loss"],"properties":{"uv_present":{"type":"boolean"},"uv_overlap_result":{"enum":["PASS","FAIL","NOT_APPLICABLE","NOT_RUN"]},"channels_present":{"type":"array","uniqueItems":true,"items":{"enum":["BASE_COLOR","NORMAL","ROUGHNESS","METALLIC","OCCLUSION","EMISSIVE","OPACITY"]}},"translation_loss":{"type":"array","items":{"type":"string"}}}},
    "rig": {"type":"object","additionalProperties":false,"required":["state","bone_count","hierarchy_valid","weights_normalized","socket_checks","deformation_tests"],"properties":{"state":{"enum":["NOT_APPLICABLE","NOT_RUN","PASS","FAIL","HUMAN_REVIEW_REQUIRED"]},"bone_count":{"oneOf":[{"type":"integer","minimum":0},{"type":"null"}]},"hierarchy_valid":{"oneOf":[{"type":"boolean"},{"type":"null"}]},"weights_normalized":{"oneOf":[{"type":"boolean"},{"type":"null"}]},"socket_checks":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["socket_id","result"],"properties":{"socket_id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9._:-]+$"},"result":{"enum":["PASS","FAIL","NOT_RUN"]}}}},"deformation_tests":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["test_id","result"],"properties":{"test_id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9._:-]+$"},"result":{"enum":["PASS","FAIL","HUMAN_REVIEW_REQUIRED","NOT_RUN"]}}}}}},
    "rights": {"type":"object","additionalProperties":false,"required":["state","distribution"],"properties":{"state":{"enum":["SYNTHETIC_FIXTURE","PRIVATE_RESEARCH","LICENSED","PUBLIC_DOMAIN","UNRESOLVED"]},"distribution":{"enum":["TEST_ONLY","PRIVATE_ONLY","PUBLIC_ALLOWED","BLOCKED"]}}},
    "technical_outcome": {"enum":["PASS","CONDITIONAL_PASS","FAIL","HUMAN_REVIEW_REQUIRED"]},
    "human_review": {"type":"object","additionalProperties":false,"required":["requirement","state","reason_codes","evidence_refs"],"properties":{"requirement":{"enum":["REQUIRED","NOT_REQUIRED"]},"state":{"enum":["PENDING","COMPLETE","NOT_APPLICABLE"]},"reason_codes":{"type":"array","items":{"type":"string"}},"evidence_refs":{"type":"array","items":{"type":"string"}}}},
    "acceptance": {"type":"object","additionalProperties":false,"required":["state","assigned_destination"],"properties":{"state":{"enum":["PENDING","ACCEPTED_AS_CANDIDATE","REJECTED","SUPERSEDED","ARCHIVED"]},"assigned_destination":{"const":"CANDIDATE_ASSET_PACKAGE"}}}
  },
  "$defs": {"vector3":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"},{"type":"number"}],"minItems":3,"maxItems":3}}
}
