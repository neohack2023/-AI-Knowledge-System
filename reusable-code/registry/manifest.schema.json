{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIOS Code Store Unit v0.1",
  "type": "object",
  "required": ["schema_version","chunk_id","version","status","candidate_digest","source_revision","validation_receipt_id","license_spdx","registry_record"],
  "properties": {
    "schema_version": {"const":"code-store-unit-v0.1"},
    "chunk_id": {"type":"string","minLength":1},
    "version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum":["VERIFIED"]},
    "candidate_digest": {"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "source_revision": {"type":"string","minLength":1},
    "validation_receipt_id": {"type":"string","minLength":1},
    "license_spdx": {"type":"string","minLength":1},
    "registry_record": {"type":"string","minLength":1}
  }
}
