  "path": "index.html",
  "mime_type": "text/html",
  "content": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n  <meta name=\"theme-color\" content=\"#050806\">\n  <meta name=\"description\" content=\"GT Terminal: browser-native systems, research, playable experiments, and spatial artifacts.\">\n  <meta name=\"gt-build\" content=\"terminal-channel-04-2026-08-25\">\n  <title>GT Terminal :: Command Deck</title>\n  <link rel=\"stylesheet\" href=\"terminal/terminal.css?v=terminal-channel-04\">\n  <script type=\"importmap\">\n    {\n      \"imports\": {\n        \"three\": \"https://cdn.jsdelivr.net/npm/three@0.183.0/build/three.webgpu.js\",\n        \"three/webgpu\": \"https://cdn.jsdelivr.net/npm/three@0.183.0/build/three.webgpu.js\",\n        \"three/tsl\": \"https://cdn.jsdelivr.net/npm/three@0.183.0/build/three.tsl.js\"\n      }\n    }\n  </script>\n  <script type=\"module\" src=\"terminal/terminal.js?v=terminal-channel-04\"></script>\n  <script type=\"module\" src=\"terminal/terminal-gpu.js?v=terminal-channel-04\"></script>\n</head>\n<body>\n  <a class=\"skip-link\" href=\"#screen-raster\">Skip to Pip-Boy screen</a>\n\n  <main class=\"device-shell\" aria-label=\"GT Terminal Pip-Boy command deck\">\n    <div class=\"hardware hardware-left\" aria-label=\"Rotary navigation controls\">\n      <span class=\"vent\" aria-hidden=\"true\"></span>\n      <span class=\"power-lamp\" aria-hidden=\"true\"></span>\n\n      <div class=\"dial-control\">\n        <span class=\"dial-label\">PREV</span>\n        <button id=\"dial-prev\" class=\"dial dial-prev\" type=\"button\" aria-label=\"Previous terminal channel\">\n          <span class=\"dial-marker\" aria-hidden=\"true\"></span>\n        </button>\n      </div>\n\n      <output id=\"dial-channel\" class=\"dial-channel\" aria-live=\"polite\">DECK</output>\n\n      <div class=\"dial-control\">\n        <button id=\"dial-next\" class=\"dial dial-next\" type=\"button\" aria-label=\"Next terminal channel\">\n          <span class=\"dial-marker\" aria-hidden=\"true\"></span>\n        </button>\n        <span class=\"dial-label\">NEXT</span>\n      </div>\n    </div>\n\n    <section class=\"crt\" data-terminal-state=\"booting\" data-signal-renderer=\"loading\">\n      <div id=\"screen-raster\" class=\"screen-raster\">\n        <canvas id=\"terminal-signal-canvas\" class=\"signal-canvas\" aria-hidden=\"true\"></canvas>\n        <div class=\"glass-noise\" aria-hidden=\"true\"></div>\n\n        <header class=\"terminal-header\">\n          <a id=\"home-control\" class=\"brand\" href=\"index.html\" aria-label=\"Return to GT Terminal command deck\">GT TERMINAL</a>\n          <div class=\"node-status\" role=\"status\">\n            <span class=\"status-dot\" aria-hidden=\"true\"></span>\n            <span id=\"node-state\">NODE BOOTING</span>\n          </div>\n        </header>\n\n        <div id=\"terminal-dashboard\" class=\"terminal-grid\">\n          <nav class=\"route-rail\" aria-label=\"GT Terminal sections\">\n            <a class=\"route is-active\" href=\"systems.html\" data-command=\"systems\"><span class=\"route-index\">01</span><span>SYSTEMS</span><span aria-hidden=\"true\">›</span></a>\n            <a class=\"route\" href=\"artifacts/vanille-spatial-relief/\" data-command=\"artifacts\"><span class=\"route-index\">02</span><span>ARTIFACTS</span><span aria-hidden=\"true\">›</span></a>\n            <a class=\"route\" href=\"research.html\" data-command=\"research\"><span class=\"route-index\">03</span><span>RESEARCH</span><span aria-hidden=\"true\">›</span></a>\n            <a class=\"route\" href=\"Games/Index.html\" data-command=\"play\"><span class=\"route-index\">04</span><span>PLAY</span><span aria-hidden=\"true\">›</span></a>\n            <a class=\"route\" href=\"Lab%20tools/Index.HTML\" data-command=\"tools\"><span class=\"route-index\">05</span><span>TOOLS</span><span aria-hidden=\"true\">›</span></a>\n          </nav>\n\n          <section class=\"terminal-panel\" aria-labelledby=\"panel-title\">\n            <h1 id=\"panel-title\" class=\"sr-only\">GT Terminal output</h1>\n            <div id=\"terminal-output\" class=\"terminal-output\" tabindex=\"0\" aria-live=\"polite\">\n              <ol id=\"boot-log\" class=\"boot-log\" aria-label=\"Boot log\">\n                <li data-delay=\"0\"><span>[ OK ]</span> Power rail check</li>\n                <li data-delay=\"1\"><span>[ OK ]</span> CRT phosphor matrix</li>\n                <li data-delay=\"2\"><span>[ OK ]</span> Filesystem mirror / 52 files</li>\n                <li data-delay=\"3\"><span>[ OK ]</span> Route index mounted</li>\n                <li data-delay=\"4\"><span>[ OK ]</span> Rotary channel controls enabled</li>\n              </ol>\n\n              <article class=\"transmission\">\n                <div class=\"transmission-heading\"><p>INCOMING TRANSMISSION</p><span>ARTIFACT / ACTIVE</span></div>\n                <div class=\"transmission-body\">\n                  <div class=\"artifact-glyph\" aria-hidden=\"true\"><span></span><span></span><span></span></div>\n                  <div>\n                    <h2>Spatial Relief Lab</h2>\n                    <p>Interactive browser-native relief experiments combining depth, splat rendering, cohesion studies, and mobile WebGL diagnostics.</p>\n                    <a href=\"artifacts/vanille-spatial-relief/\" data-open-command=\"artifacts\">OPEN FIXTURE 01 <span aria-hidden=\"true\">→</span></a>\n                  </div>\n                </div>\n              </article>\n            </div>\n\n            <form id=\"command-form\" class=\"command-line\" autocomplete=\"off\">\n              <label for=\"command-input\" class=\"prompt\" aria-label=\"Command prompt\">›</label>\n              <input id=\"command-input\" name=\"command\" type=\"text\" inputmode=\"text\" spellcheck=\"false\" placeholder=\"Enter command…\" aria-describedby=\"command-help\">\n              <button type=\"submit\">RUN</button>\n            </form>\n            <p id=\"command-help\" class=\"sr-only\">Commands: help, home, systems, artifacts, research, play, tools, status, audio, clear.</p>\n          </section>\n        </div>\n\n        <section id=\"page-view\" class=\"page-view\" aria-label=\"Selected terminal channel\" hidden>\n          <div class=\"channel-toolbar\">\n            <button id=\"mobile-prev\" type=\"button\" aria-label=\"Previous channel\">PREV</button>\n            <span>CHANNEL: <strong id=\"channel-name\">SYSTEMS</strong></span>\n            <button id=\"mobile-home\" type=\"button\">DECK</button>\n            <button id=\"mobile-next\" type=\"button\" aria-label=\"Next channel\">NEXT</button>\n          </div>\n          <div class=\"page-frame-shell\">\n            <div id=\"page-loading\" class=\"page-loading\" role=\"status\">TUNING CHANNEL…</div>\n            <iframe id=\"page-frame\" title=\"GT Terminal channel\" src=\"about:blank\"></iframe>\n          </div>\n        </section>\n\n        <footer class=\"system-footer\" aria-label=\"System status\">\n          <span>STATUS: <strong id=\"system-status\">BOOTING</strong></span>\n          <button id=\"audio-toggle\" type=\"button\" aria-pressed=\"false\">AUDIO: <strong id=\"audio-state\">OFF</strong></button>\n          <span>LINK: <strong id=\"link-state\">PUBLIC</strong></span>\n          <span>SIGNAL: <strong id=\"signal-state\">LOADING</strong></span>\n        </footer>\n      </div>\n\n      <div class=\"crt-switch-line\" aria-hidden=\"true\"></div>\n    </section>\n\n    <div class=\"hardware hardware-right\" aria-label=\"Pip-Boy function controls\">\n      <button id=\"sync-control\" type=\"button\">SYNC</button>\n      <button id=\"scan-control\" type=\"button\">SCAN</button>\n      <button id=\"hold-control\" type=\"button\" aria-pressed=\"false\">HOLD</button>\n      <button id=\"reset-control\" type=\"button\">RESET</button>\n    </div>\n  </main>\n\n  <noscript><p class=\"noscript\">JavaScript is disabled. Navigation remains available through the section links.</p></noscript>\n</body>\n</html>\n"
}
