  "content": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n  <meta name=\"theme-color\" content=\"#050806\">\n  <meta name=\"description\" content=\"GT Terminal: browser-native systems, research, playable experiments, and spatial artifacts.\">\n  <meta name=\"gt-build\" content=\"terminal-shell-01-2026-08-25\">\n  <title>GT Terminal :: Command Deck</title>\n  <link rel=\"stylesheet\" href=\"terminal/terminal.css\">\n  <script type=\"module\" src=\"terminal/terminal.js\"></script>\n</head>\n<body>\n  <a class=\"skip-link\" href=\"#terminal-output\">Skip to terminal output</a>\n\n  <main class=\"device-shell\" aria-label=\"GT Terminal command deck\">\n    <div class=\"hardware hardware-left\" aria-hidden=\"true\">\n      <span class=\"vent\"></span>\n      <span class=\"power-lamp\"></span>\n      <span class=\"dial dial-one\"></span>\n      <span class=\"dial dial-two\"></span>\n    </div>\n\n    <section class=\"crt\" data-terminal-state=\"booting\">\n      <div class=\"glass-noise\" aria-hidden=\"true\"></div>\n\n      <header class=\"terminal-header\">\n        <a class=\"brand\" href=\"index.html\" aria-label=\"GT Terminal home\">GT TERMINAL</a>\n        <div class=\"node-status\" role=\"status\">\n          <span class=\"status-dot\" aria-hidden=\"true\"></span>\n          <span id=\"node-state\">NODE BOOTING</span>\n        </div>\n      </header>\n\n      <div class=\"terminal-grid\">\n        <nav class=\"route-rail\" aria-label=\"GT Terminal sections\">\n          <a class=\"route is-active\" href=\"systems.html\" data-command=\"systems\">\n            <span class=\"route-index\">01</span><span>SYSTEMS</span><span aria-hidden=\"true\">›</span>\n          </a>\n          <a class=\"route\" href=\"artifacts/vanille-spatial-relief/\" data-command=\"artifacts\">\n            <span class=\"route-index\">02</span><span>ARTIFACTS</span><span aria-hidden=\"true\">›</span>\n          </a>\n          <a class=\"route\" href=\"research.html\" data-command=\"research\">\n            <span class=\"route-index\">03</span><span>RESEARCH</span><span aria-hidden=\"true\">›</span>\n          </a>\n          <a class=\"route\" href=\"Games/Index.html\" data-command=\"play\">\n            <span class=\"route-index\">04</span><span>PLAY</span><span aria-hidden=\"true\">›</span>\n          </a>\n          <a class=\"route\" href=\"Lab%20tools/Index.HTML\" data-command=\"tools\">\n            <span class=\"route-index\">05</span><span>TOOLS</span><span aria-hidden=\"true\">›</span>\n          </a>\n        </nav>\n\n        <section class=\"terminal-panel\" aria-labelledby=\"panel-title\">\n          <h1 id=\"panel-title\" class=\"sr-only\">GT Terminal output</h1>\n          <div id=\"terminal-output\" class=\"terminal-output\" tabindex=\"0\" aria-live=\"polite\">\n            <ol id=\"boot-log\" class=\"boot-log\" aria-label=\"Boot log\">\n              <li data-delay=\"0\"><span>[ OK ]</span> Power rail check</li>\n              <li data-delay=\"1\"><span>[ OK ]</span> CRT phosphor matrix</li>\n              <li data-delay=\"2\"><span>[ OK ]</span> Filesystem mirror / 52 files</li>\n              <li data-delay=\"3\"><span>[ OK ]</span> Route index mounted</li>\n              <li data-delay=\"4\"><span>[ OK ]</span> Visitor controls enabled</li>\n            </ol>\n\n            <article class=\"transmission\">\n              <div class=\"transmission-heading\">\n                <p>INCOMING TRANSMISSION</p>\n                <span>ARTIFACT / ACTIVE</span>\n              </div>\n              <div class=\"transmission-body\">\n                <div class=\"artifact-glyph\" aria-hidden=\"true\">\n                  <span></span><span></span><span></span>\n                </div>\n                <div>\n                  <h2>Spatial Relief Lab</h2>\n                  <p>Interactive browser-native relief experiments combining depth, splat rendering, cohesion studies, and mobile WebGL diagnostics.</p>\n                  <a href=\"artifacts/vanille-spatial-relief/\">OPEN FIXTURE 01 <span aria-hidden=\"true\">→</span></a>\n                </div>\n              </div>\n            </article>\n          </div>\n\n          <form id=\"command-form\" class=\"command-line\" autocomplete=\"off\">\n            <label for=\"command-input\" class=\"prompt\" aria-label=\"Command prompt\">›</label>\n            <input id=\"command-input\" name=\"command\" type=\"text\" inputmode=\"text\" spellcheck=\"false\" placeholder=\"Enter command…\" aria-describedby=\"command-help\">\n            <button type=\"submit\">RUN</button>\n          </form>\n          <p id=\"command-help\" class=\"sr-only\">Commands: help, systems, artifacts, research, play, tools, status, clear.</p>\n        </section>\n      </div>\n\n      <footer class=\"system-footer\" aria-label=\"System status\">\n        <span>STATUS: <strong id=\"system-status\">BOOTING</strong></span>\n        <span>POWER: <strong>STABLE</strong></span>\n        <span>LINK: <strong>PUBLIC</strong></span>\n        <span>BUILD: <strong>TERMINAL-SHELL-01</strong></span>\n      </footer>\n    </section>\n\n    <div class=\"hardware hardware-right\" aria-hidden=\"true\">\n      <span>SYNC</span><span>SCAN</span><span>HOLD</span><span>RESET</span>\n    </div>\n  </main>\n\n  <noscript>\n    <p class=\"noscript\">JavaScript is disabled. Navigation remains available through the section links.</p>\n  </noscript>\n</body>\n</html>\n"
}
