{
  "name": "ai-knowledge-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-transform-types --test tests/*.test.mjs tests/*.test.ts && npm run test:agent-system && npm run check:agent-system && npm run test:spatial-compiler && npm run check:public-release",
    "test:agent-system": "node --test tests/agent-system-audit.test.mjs",
    "check:agent-system": "node scripts/agent-system/audit.mjs --report outputs/agent-system-audit.json",
    "test:spatial-compiler": "npm --prefix packages/spatial-three-compiler ci --ignore-scripts && npm --prefix packages/spatial-three-compiler test",
    "check:public-release": "node scripts/public-release/check.mjs --manifest public-release-manifest.yaml --report outputs/public-release-report.json",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "coding-harness:receipt": "node --experimental-transform-types scripts/coding-harness/emit-receipt.ts",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "AI Knowledge System"
}
